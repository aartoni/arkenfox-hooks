[Trigger]
Operation = Upgrade
Type = Package
Target = arkenfox-user.js

[Action]
Description = Update Arkenfox user.js
When = PostTransaction
Depends = arkenfox-user.js
Depends = sudo
Exec = /bin/sh -c '[ -n "$SUDO_USER" ] || { echo "SUDO_USER unset, skipping"; exit 0; }; exec sudo -u "$SUDO_USER" /usr/bin/arkenfox-updater'
